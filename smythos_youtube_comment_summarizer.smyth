      }
    },
    {
      "id": "8a7643de-d014-4377-9055-79ee738b6231",
      "name": "Embeddings",
      "type": "code",
      "config": {
        "model": "text-embedding-3-small",
        "options": {}
      }
    },
    {
      "id": "841e4571-f1c6-49e0-8520-5d4a244b057f",
      "name": "Pinecone Insert",
      "type": "code",
      "config": {
        "mode": "insert",
        "options": {},
        "pineconeIndex": {
          "__rl": true,
          "value": "youtube_comment_summarizer",
          "mode": "list",
          "cachedResultName": "youtube_comment_summarizer"
        }
      }
    },
    {
      "id": "d85e823f-715b-489b-9628-61ce63cb33fe",
      "name": "Pinecone Query",
      "type": "code",
      "config": {
        "pineconeIndex": {
          "__rl": true,
          "value": "youtube_comment_summarizer",
          "mode": "list",
          "cachedResultName": "youtube_comment_summarizer"
        }
      }
    },
    {
      "id": "0737745f-be5b-4e98-b85b-45a3412f09e9",
      "name": "Vector Tool",
      "type": "code",
      "config": {
        "name": "Pinecone",
        "description": "Vector context"
      }
    },
    {
      "id": "b8a28d57-b2d0-4ccd-8748-d484099c2bd5",
      "name": "Window Memory",
      "type": "code",
      "config": {}
    },
    {
      "id": "93fe9b1d-0b94-4f3a-a864-fda08cd201ce",
      "name": "Chat Model",
      "type": "code",
      "config": {
        "options": {}
      }
    },
    {
      "id": "a3218023-dcc5-4302-9506-a498a28823b4",
      "name": "RAG Agent",
      "type": "code",
      "config": {
        "promptType": "define",
        "text": "Handle data",
        "options": {
          "systemMessage": "You are an assistant for YouTube Comment Summarizer"
        }
      }
    },
    {
      "id": "1d624247-2c74-46c5-89e4-624b0c62bb87",
      "name": "Append Sheet",
      "type": "code",
      "config": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "SHEET_ID",
          "mode": "list",
          "cachedResultName": "YouTube Comment Summarizer"
        },
        "sheetName": {
          "__rl": true,
          "value": "Log",
          "mode": "list",
          "cachedResultName": "Log"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": "Status",
          "schema": []
        }
      }
    },
    {
      "id": "361ae790-4e53-4a0c-8684-5a448b2ae5e9",
      "name": "Slack Alert",
      "type": "code",
      "config": {
        "channel": "#alerts",
        "text": "YouTube Comment Summarizer error: {$json.error.message}"
      }
    }
  ],
  "connections": [
    {
      "from": "Webhook Trigger",
      "to": "Text Splitter"
    },
    {
      "from": "Webhook Trigger",
      "to": "Window Memory"
    },
    {
      "from": "Text Splitter",
      "to": "Embeddings"
    },
    {
      "from": "RAG Agent",
      "to": "Append Sheet"
    }
  ],
  "default_model": "gpt-4o"
}